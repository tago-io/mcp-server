              "key": {
                "description": "Parameter key.",
                "type": "string",
              },
              "sent": {
                "description": "Whether the parameter was already sent to the device.",
                "type": "boolean",
              },
              "value": {
                "description": "Parameter value.",
                "type": "string",
              },
            },
            "required": [
              "sent",
              "key",
              "value",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "connector": {
          "description": "The connector ID (required, find one with search_connectors).",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
        },
        "description": {
          "description": "Device description.",
          "type": "string",
        },
        "name": {
          "description": "The device name.",
          "minLength": 1,
          "type": "string",
        },
        "network": {
          "description": "The network ID. Optional: when omitted it is derived from the connector if the connector supports exactly one network. Find candidates with search_networks.",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
        },
        "payload_decoder": {
          "description": "Payload parser JavaScript source. Sent base64-encoded automatically.",
          "type": "string",
        },
        "serie_number": {
          "description": "Serial number (EUI, MQTT client ID, or IMEI).",
          "type": "string",
        },
        "tags": {
          "description": "Tags. E.g: [{ key: 'device_type', value: 'sensor' }]",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Tag key",
                "type": "string",
