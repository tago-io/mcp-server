  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Number of items to return (min 1, max 200, default 20).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "fields": {
          "description": "Fields to request from the API. Defaults to all of: id, active, name, created_at, updated_at, last_triggered, tags, type, action. Also controls the rendered columns: when supplied, output shows exactly these fields, even in concise mode.",
          "items": {
            "enum": [
              "id",
              "active",
              "name",
              "created_at",
              "updated_at",
              "last_triggered",
              "tags",
              "type",
              "action",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "filter": {
          "additionalProperties": false,
          "description": "Filter object to apply to the query.",
          "properties": {
            "active": {
              "description": "Filter by active status. E.g: true",
              "type": "boolean",
            },
            "created_at": {
              "description": "Filter by creation date. E.g: '2021-01-01'",
              "type": "string",
            },
            "name": {
              "description": "Filter by action name. Wildcard matching is applied automatically, so "notification" matches "Notification Action" and "Notification Action 2".",
              "type": "string",
            },
            "orderBy": {
              "description": "Sort as "field,direction". Field is one of: name, active, last_triggered, created_at, updated_at; direction is asc or desc. E.g: "name,asc"",
              "type": "string",
            },
            "tags": {
              "description": "Filter by tags. E.g: [{ key: 'action_type', value: 'notification' }]",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "description": "Tag key",
                    "type": "string",
                  },
                  "value": {
                    "description": "Tag value",
                    "type": "string",
                  },
                },
                "required": [
                  "key",
                  "value",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "updated_at": {
              "description": "Filter by last update date. E.g: '2021-01-01'",
              "type": "string",
            },
          },
          "type": "object",
        },
        "page": {
          "description": "Page of results, starting from 1.",
          "minimum": 1,
          "type": "integer",
        },
        "response_format": {
          "description": "Response verbosity. 'concise' (default) returns key identity fields; 'detailed' returns every field.",
          "enum": [
            "concise",
            "detailed",
          ],
          "type": "string",
