              "width",
              "height",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "label": {
          "description": "The label (display name) for the dashboard.",
          "minLength": 1,
          "type": "string",
        },
        "tabs": {
          "description": "Dashboard tabs. Keys must be unique. E.g: [{ "key": "overview", "value": "Overview" }]",
          "items": {
            "additionalProperties": true,
            "properties": {
              "hidden": {
                "description": "Whether the tab is hidden. Nullable; stored dashboards may carry null.",
                "type": [
                  "boolean",
                  "null",
                ],
              },
              "key": {
                "description": "Unique tab key.",
                "type": "string",
              },
              "value": {
                "description": "Tab display name.",
