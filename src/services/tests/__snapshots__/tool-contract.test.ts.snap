  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "data": {
          "description": "Data records to store.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "group": {
                "description": "Group ID to correlate values recorded together.",
                "type": "string",
              },
              "location": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "lat": {
                        "description": "Latitude.",
                        "type": "number",
                      },
                      "lng": {
                        "description": "Longitude.",
                        "type": "number",
                      },
                    },
                    "required": [
                      "lat",
                      "lng",
                    ],
                    "type": "object",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Coordinates for the value.",
              },
              "metadata": {
                "additionalProperties": {},
                "description": "Free-form metadata object.",
                "type": "object",
              },
              "time": {
                "description": "ISO 8601 timestamp. Defaults to now.",
                "type": "string",
              },
              "unit": {
                "description": "Unit of measurement, e.g. '°C'.",
                "type": "string",
              },
              "value": {
                "description": "The value.",
                "type": [
                  "string",
                  "number",
                  "boolean",
                ],
              },
              "variable": {
                "description": "Variable name in snake_case, alphanumeric only.",
                "type": "string",
              },
            },
            "required": [
              "variable",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
        "device_id": {
          "description": "The 24-character device ID.",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
        },
      },
      "required": [
        "device_id",
        "data",
      ],
      "type": "object",
    },
