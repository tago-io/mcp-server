          "description": "Number of items to return (min 1, max 10000, default 20).",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer",
        },
        "entity_id": {
          "description": "The 24-character entity ID.",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
        },
        "fields": {
          "description": "Schema fields to return per row. Also controls the rendered columns: when supplied, output shows exactly these fields, even in concise mode.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "filter": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Field/value pairs to match. Keys must be fields of the chosen index, forming a left-to-right prefix of it (skipping an intermediate field is invalid).",
          "type": "object",
        },
        "index": {
          "description": "Index to query through (from get_entity). Defaults to the server's \`id_created_at_idx\` index (fields: id, created_at).",
          "type": "string",
        },
        "order_by": {
          "description": "Sort direction, applied to the chosen index's LAST field; there is no arbitrary order-by.",
          "enum": [
            "asc",
            "desc",
          ],
          "type": "string",
        },
        "page": {
          "description": "Page of results, starting from 1.",
          "minimum": 1,
          "type": "integer",
        },
        "response_format": {
          "description": "Response verbosity. 'concise' (default) returns key identity fields; 'detailed' returns every field.",
          "enum": [
            "concise",
            "detailed",
          ],
          "type": "string",
        },
