                  "type": "string",
                },
              },
              "required": [
                "type",
                "message",
                "subject",
                "to",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "description": "The SMS message.",
                  "type": "string",
                },
                "to": {
                  "description": "The phone number to send the SMS to.",
                  "type": "string",
                },
                "type": {
                  "const": "sms",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "message",
                "to",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "bucket": {
                  "description": "The device ID to receive the MQTT published message.",
                  "type": "string",
                },
                "payload": {
                  "description": "The message that will be published to the MQTT topic.",
                  "type": "string",
                },
                "topic": {
                  "description": "The topic of the MQTT message.",
                  "type": "string",
                },
                "type": {
                  "const": "mqtt",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "bucket",
                "payload",
                "topic",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "headers": {
                  "additionalProperties": {
                    "type": "string",
                  },
                  "description": "The headers of the POST request. Pass an empty object \`{}\` when no headers are needed.",
                  "type": "object",
                },
                "type": {
                  "const": "post",
                  "type": "string",
                },
                "url": {
                  "description": "The URL of the POST request.",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "url",
                "headers",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "description": "The Twilio phone number that sends the SMS.",
                  "type": "string",
                },
                "message": {
                  "description": "The SMS message.",
                  "type": "string",
                },
                "to": {
                  "description": "The phone number to send the SMS to.",
                  "type": "string",
                },
                "twilio_sid": {
                  "description": "The ID of the secret that contains the Twilio SID.",
