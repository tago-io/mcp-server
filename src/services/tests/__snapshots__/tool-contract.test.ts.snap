      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "active": {
          "description": "Whether the analysis starts enabled. Defaults to true.",
          "type": "boolean",
        },
        "description": {
          "description": "The description for the analysis.",
          "type": "string",
        },
        "environment_variables": {
          "description": "Environment variables available to the script (max 20, unique keys). Values are sensitive and never echoed back. Replaces the current set entirely when updating.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Environment variable name.",
                "minLength": 1,
                "type": "string",
              },
              "value": {
                "description": "Environment variable value. Sensitive; never echoed back in results.",
                "type": [
                  "string",
                  "number",
                  "boolean",
                ],
              },
            },
            "required": [
              "key",
              "value",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "type": "array",
        },
        "interval": {
          "description": "Schedule interval for automatic runs, e.g. '5 minutes' or '1 hour'. Omit for trigger-only analyses.",
          "type": "string",
        },
        "name": {
          "description": "The name for the analysis.",
          "minLength": 1,
          "type": "string",
        },
        "runtime": {
          "description": "Runtime for the new analysis; it cannot be changed later. Defaults to \`deno-rt2025\`, which resolves imports automatically. \`node-rt2025\` installs no third-party dependencies: package imports must be pre-bundled into one file, but import-free JavaScript using runtime globals (\`process.env\`, \`fetch\`) works without bundling.",
          "enum": [
            "node-rt2025",
            "python-rt2025",
            "deno-rt2025",
          ],
          "type": "string",
        },
        "tags": {
          "description": "The tags for the analysis. E.g: [{ key: 'analysis_type', value: 'invoice' }]",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Tag key",
                "type": "string",
              },
              "value": {
                "description": "Tag value",
                "type": "string",
              },
            },
            "required": [
              "key",
              "value",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "create_analysis",
    "title": "Create Analysis",
  },
  {
    "annotations": {
