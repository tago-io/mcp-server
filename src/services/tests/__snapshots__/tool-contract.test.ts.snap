            "week",
            "month",
            "quarter",
          ],
          "type": "string",
        },
        "chunk_retention": {
          "description": "How many chunk periods to retain data. Required for immutable devices.",
          "maximum": 36500,
          "minimum": 0,
          "type": "integer",
        },
        "configuration_params": {
          "description": "Configuration parameters to set after creation.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Existing parameter ID (update). Omit to create a new parameter.",
                "type": "string",
