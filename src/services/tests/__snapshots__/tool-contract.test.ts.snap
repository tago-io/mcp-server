    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "script": {
                  "description": "The analysis IDs to run when the action triggers.",
                  "items": {
                    "type": "string",
                  },
                  "minItems": 1,
                  "type": "array",
                },
                "type": {
                  "const": "script",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "script",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "description": "The message of the notification.",
                  "type": "string",
                },
                "subject": {
                  "description": "The subject of the notification.",
                  "type": "string",
                },
                "type": {
                  "const": "notification",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "message",
                "subject",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "description": "The message of the notification.",
                  "type": "string",
                },
                "run_user": {
                  "description": "The Run user ID that will receive the notification.",
                  "type": "string",
                },
                "subject": {
                  "description": "The subject of the notification.",
                  "type": "string",
                },
                "type": {
                  "const": "notification_run",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "message",
                "subject",
                "run_user",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "description": "The body of the email.",
                  "type": "string",
                },
                "subject": {
                  "description": "The subject of the email.",
                  "type": "string",
                },
                "to": {
                  "description": "The email address to send the email to.",
                  "type": "string",
                },
                "type": {
