                "message",
                "to",
                "from",
                "twilio_sid",
                "twilio_token",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "content_sid": {
                  "description": "The ID of the secret that contains the WhatsApp message template SID.",
                  "type": "string",
                },
                "content_variables": {
                  "description": "The variables to be sent to the Twilio WhatsApp message template. Pass an empty array \`[]\` when the template has no variables.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "description": "The name of the variable.",
                        "type": "string",
                      },
                      "value": {
                        "description": "The value of the variable.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "name",
                      "value",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "from": {
                  "description": "The Twilio phone number that sends the WhatsApp message.",
                  "type": "string",
                },
                "message": {
                  "description": "The WhatsApp message.",
                  "type": "string",
                },
                "to": {
                  "description": "The phone number to send the WhatsApp message to.",
                  "type": "string",
                },
                "twilio_sid": {
                  "description": "The ID of the secret that contains the Twilio SID.",
                  "type": "string",
                },
                "twilio_token": {
                  "description": "The ID of the secret that contains the Twilio token.",
                  "type": "string",
                },
                "type": {
                  "const": "whatsapp-twilio",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "message",
                "to",
                "from",
                "content_sid",
                "twilio_sid",
                "twilio_token",
                "content_variables",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "description": "The email address that sends the email.",
                  "type": "string",
                },
                "message": {
                  "description": "The body of the email.",
                  "type": "string",
                },
                "sendgrid_api_key": {
                  "description": "The ID of the secret that contains the SendGrid API key.",
                  "type": "string",
                },
                "subject": {
                  "description": "The subject of the email.",
                  "type": "string",
                },
                "to": {
                  "description": "The email address to send the email to.",
                  "type": "string",
                },
                "type": {
                  "const": "email-sendgrid",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "message",
                "subject",
                "to",
                "from",
                "sendgrid_api_key",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "description": "The email address that sends the email.",
                  "type": "string",
                },
                "message": {
                  "description": "The body of the email.",
                  "type": "string",
                },
                "smtp_secret": {
                  "description": "The ID of the secret that contains the SMTP credentials.",
                  "type": "string",
                },
                "subject": {
                  "description": "The subject of the email.",
                  "type": "string",
                },
                "to": {
                  "description": "The email address to send the email to.",
                  "type": "string",
                },
                "type": {
                  "const": "email-smtp",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "message",
                "subject",
                "to",
                "from",
                "smtp_secret",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "batch_enabled": {
                  "description": "Whether the SQS queue is batch enabled.",
                  "type": "boolean",
                },
                "sqs_secret": {
                  "description": "The ID of the secret that contains the AWS SQS credentials.",
                  "type": "string",
                },
                "type": {
                  "const": "queue-sqs",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "sqs_secret",
                "batch_enabled",
              ],
              "type": "object",
            },
          ],
          "description": "What the action executes when triggered, discriminated by \`type\`. Each type has its own required fields.",
        },
        "action_id": {
          "description": "The 24-character action ID.",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
        },
        "active": {
          "description": "Enable or disable the action.",
          "type": "boolean",
        },
        "description": {
          "description": "The new description for the action.",
          "type": "string",
        },
        "name": {
          "description": "The new name for the action.",
          "minLength": 1,
          "type": "string",
        },
        "tags": {
          "description": "The new tags for the action, replacing the current ones.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Tag key",
                "type": "string",
              },
              "value": {
                "description": "Tag value",
                "type": "string",
              },
            },
            "required": [
              "key",
              "value",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "trigger": {
          "description": "The new trigger configuration, replacing the current one. Must be sent together with \`type\`.",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "description": "This schema is used when the trigger is based on type resource.",
                "properties": {
                  "resource": {
                    "description": "The resource to monitor",
                    "enum": [
                      "device",
                      "bucket",
                      "file",
                      "analysis",
                      "action",
                      "am",
                      "user",
                      "financial",
                      "profile",
                    ],
                    "type": "string",
                  },
                  "tag_key": {
                    "description": "The tag key to match",
                    "type": "string",
                  },
                  "tag_value": {
                    "description": "The tag value to match",
                    "type": "string",
                  },
                  "when": {
                    "description": "The event type to trigger on",
                    "enum": [
                      "create",
                      "update",
                      "delete",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "resource",
                  "when",
                  "tag_key",
                  "tag_value",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "description": "This schema is used when the trigger is based on type interval.",
                "properties": {
                  "interval": {
                    "description": "This is the time between each trigger.
      This is the time between each trigger. Could be in:
      - minutes - 3 minutes
      - hours - 8 hours
      - days - 10 days
      - weeks - 2 week
      - months - 4 month
      - quarters - 3 quarter
      - years - 1 year
      ",
                    "type": "string",
                  },
                },
                "required": [
                  "interval",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "description": "This schema is used when the trigger is based on type schedule.",
                "properties": {
                  "cron": {
                    "description": "The cron expression for scheduling",
                    "type": "string",
                  },
                  "timezone": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "format": "date-time",
                        "type": "string",
                      },
                    ],
                    "description": "The timezone for the schedule",
                  },
                },
                "required": [
                  "timezone",
                  "cron",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "description": "This schema is used when the trigger is based on type condition.",
                "properties": {
                  "device": {
                    "description": "The device ID to monitor",
                    "type": "string",
                  },
                  "is": {
                    "description": "The comparison operator: "<", ">", "=", "!" (not equal), "><" (between, requires second_value), "*" (any value)",
                    "enum": [
                      "<",
                      ">",
                      "=",
                      "!",
                      "><",
                      "*",
                    ],
                    "type": "string",
                  },
                  "second_value": {
                    "description": "Second value for "><" (between) comparisons",
                    "type": "string",
                  },
                  "unlock": {
                    "description": "Whether to unlock when condition is met",
                    "type": "boolean",
                  },
                  "value": {
                    "description": "The value to compare against",
                    "type": "string",
                  },
                  "value_type": {
                    "description": "The type of value being compared",
                    "enum": [
                      "string",
                      "number",
                      "boolean",
                      "*",
                    ],
                    "type": "string",
                  },
                  "variable": {
                    "description": "The variable name to check",
                    "type": "string",
                  },
                },
                "required": [
                  "device",
                  "variable",
                  "is",
                  "value",
                  "value_type",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "description": "This schema is used when the trigger is based on type usage_alert.",
                "properties": {
                  "condition": {
                    "description": "The comparison operator",
                    "enum": [
                      "=",
                      ">",
                    ],
                    "type": "string",
                  },
                  "condition_value": {
                    "description": "The threshold value",
                    "type": "number",
                  },
                  "service_or_resource": {
                    "description": "The service/resource to monitor",
                    "enum": [
                      "input",
                      "output",
                      "analysis",
                      "data_records",
                      "sms",
                      "email",
                      "run_users",
                      "push_notification",
                      "file_storage",
                      "device",
                      "dashboard",
                      "action",
                      "tcore",
                      "team_members",
                      "am",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "service_or_resource",
                  "condition",
                  "condition_value",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "description": "This schema is used when the trigger is based on type condition_geofence.",
                "properties": {
                  "device": {
                    "description": "The device ID to monitor",
                    "type": "string",
                  },
                  "is": {
                    "description": "Whether to trigger when entering or exiting",
                    "enum": [
                      "IN",
                      "OUT",
                    ],
                    "type": "string",
                  },
                  "unlock": {
                    "description": "Whether to unlock when condition is met",
                    "type": "boolean",
                  },
                  "value": {
                    "additionalProperties": false,
                    "description": "The geofence definition",
                    "properties": {
                      "center": {
                        "description": "Center coordinates [longitude, latitude]",
                        "items": {
                          "type": "number",
                        },
                        "type": "array",
                      },
                      "coordinates": {
                        "description": "Polygon coordinates [[lon,lat], ...]",
                        "items": {
                          "items": {
                            "type": "number",
                          },
                          "type": "array",
                        },
                        "type": "array",
                      },
                      "radius": {
                        "description": "Radius in kilometers",
                        "type": "number",
                      },
                    },
                    "type": "object",
                  },
                  "variable": {
                    "description": "The variable containing location data",
                    "type": "string",
                  },
                },
                "required": [
                  "device",
                  "variable",
                  "is",
                  "value",
                ],
                "type": "object",
              },
            ],
          },
          "type": "array",
        },
        "trigger_when_unlock": {
          "description": "Trigger the action when the unlock condition is met. Only available for actions of type condition or condition_geofence.",
          "type": "boolean",
        },
        "type": {
          "description": "The type of trigger for the action.

The type parameter accepts one of seven values:
- "condition": Monitors device variables against specified conditions (threshold, comparison operators)
- "resource": Responds to CRUD operations on platform resources (device, file, analysis, action, am, user)
  - Resource triggers must specify which resource type to monitor (device, file, analysis, action, am, user) and which operations (create, update, delete).
- "interval": Executes actions at regular time intervals (minutes, hours, days)
- "schedule": Executes actions at specific dates/times using cron-like scheduling
- "mqtt_topic": Responds to publications on specified MQTT topics
- "condition_geofence": Triggers when devices enter or exit defined geographical boundaries
- "usage_alert": Monitors account usage metrics against thresholds for services like input/output data, analysis minutes, SMS, email, push notifications, file storage, and resource counts
  - Usage alert triggers must specify the monitored resource (input, output, analysis, data_records, sms, email, run_users, push_notification, file_storage, device, dashboard, action, tcore, team_members, am) and threshold values.",
          "enum": [
            "condition",
            "resource",
            "interval",
            "schedule",
            "mqtt_topic",
            "usage_alert",
            "condition_geofence",
          ],
          "type": "string",
        },
      },
      "required": [
        "action_id",
      ],
      "type": "object",
    },
    "name": "update_action",
    "title": "Update Action",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "active": {
          "description": "Enable or disable the analysis.",
          "type": "boolean",
        },
        "analysis_id": {
          "description": "The 24-character analysis ID.",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
        },
        "description": {
          "description": "The new description for the analysis.",
          "type": "string",
        },
        "environment_variables": {
          "description": "Environment variables available to the script (max 20, unique keys). Values are sensitive and never echoed back. Replaces the current set entirely when updating.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Environment variable name.",
                "minLength": 1,
                "type": "string",
              },
              "value": {
                "description": "Environment variable value. Sensitive; never echoed back in results.",
                "type": [
                  "string",
                  "number",
                  "boolean",
                ],
              },
            },
            "required": [
              "key",
              "value",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "type": "array",
        },
        "interval": {
          "description": "The new schedule interval, e.g. '5 minutes' or '1 hour'.",
          "type": "string",
        },
        "name": {
          "description": "The new name for the analysis.",
          "minLength": 1,
          "type": "string",
        },
        "tags": {
          "description": "The new tags for the analysis, replacing the current ones.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Tag key",
                "type": "string",
              },
              "value": {
                "description": "Tag value",
                "type": "string",
              },
            },
            "required": [
              "key",
              "value",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "analysis_id",
      ],
      "type": "object",
    },
    "name": "update_analysis",
    "title": "Update Analysis",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "arrangement": {
          "description": "Widget placement grid. Replaces the current arrangement atomically; always send the complete desired arrangement.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "height": {
                "description": "Height in grid units.",
                "type": "number",
              },
              "tab": {
                "description": "Tab key the widget is placed on. Nullable; stored arrangements may carry null.",
                "type": [
                  "string",
                  "null",
                ],
              },
              "widget_id": {
                "description": "The 24-character widget ID.",
                "maxLength": 24,
                "minLength": 24,
                "type": "string",
              },
              "width": {
                "description": "Width in grid units.",
                "type": "number",
              },
              "x": {
                "description": "Column position (grid units).",
                "type": "number",
              },
              "y": {
                "description": "Row position (grid units).",
                "type": "number",
              },
            },
            "required": [
              "widget_id",
              "x",
              "y",
              "width",
              "height",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "dashboard_id": {
          "description": "The 24-character dashboard ID.",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
