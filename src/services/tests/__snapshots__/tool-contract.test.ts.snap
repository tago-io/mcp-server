  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "description": "The 24-character device ID.",
          "maxLength": 24,
          "minLength": 24,
          "type": "string",
        },
        "end_date": {
          "description": "End date as ISO 8601 string. Defaults to now.",
          "type": "string",
        },
        "function": {
          "description": "Aggregate function (avg/sum/min/max for query='aggregate') or comparison operator (gt/gte/lt/lte/eq/ne for query='conditional').",
          "enum": [
            "avg",
            "sum",
            "min",
            "max",
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "ne",
          ],
          "type": "string",
        },
        "groups": {
          "description": "Filter by groups. E.g: ['1738000000000']",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "ids": {
          "description": "Filter by record IDs.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "interval": {
          "description": "Aggregation interval, required for query='aggregate'.",
          "enum": [
            "minute",
            "hour",
            "day",
            "month",
            "quarter",
            "year",
          ],
          "type": "string",
        },
        "ordination": {
          "description": "Sort order by time. Default 'descending'.",
          "enum": [
            "descending",
            "ascending",
          ],
          "type": "string",
        },
        "qty": {
          "description": "Quantity of records (min 1, max 10000, default 15).",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Query type. 'default' pages through records (qty/skip). last_*/first_* return single records. min/max/count compute over filtered records. avg/sum also compute but require start_date (period must not exceed one month). 'aggregate' groups by time interval (requires interval + function avg/sum/min/max). 'conditional' filters by value comparison (requires start_date + value + function gt/gte/lt/lte/eq/ne). interval/function/value are only valid on aggregate/conditional queries.",
          "enum": [
            "default",
            "last_item",
            "last_value",
            "last_location",
            "last_insert",
            "first_item",
            "first_value",
            "first_location",
            "first_insert",
            "min",
            "max",
            "count",
            "avg",
            "sum",
            "aggregate",
            "conditional",
          ],
          "type": "string",
        },
        "response_format": {
          "description": "Response verbosity. 'concise' (default) returns key identity fields; 'detailed' returns every field.",
          "enum": [
            "concise",
            "detailed",
          ],
          "type": "string",
        },
        "skip": {
          "description": "Records to skip, for pagination.",
          "minimum": 0,
          "type": "integer",
        },
        "start_date": {
          "description": "Start date as ISO 8601 string. E.g: '2026-06-01T00:00:00Z'",
          "type": "string",
        },
        "value": {
          "description": "Comparison value, required for query='conditional'.",
          "type": "number",
        },
        "values": {
          "description": "Filter by values. E.g: [25.5, 'high', true]",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
            ],
          },
          "type": "array",
        },
        "variables": {
          "description": "Filter by variable names. E.g: ['temperature', 'humidity']",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "device_id",
      ],
      "type": "object",
    },
    "name": "read_device_data",
    "title": "Read Device Data",
  },
